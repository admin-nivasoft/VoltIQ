# Copy to .env for local use. Never commit .env. Values here are dev-only placeholders.

# --- Runtime (D-08) ---
NODE_ENV=development
PORT=3000
# The API refuses to start with AUTH_PROVIDER=mock when NODE_ENV=production.
# Local dev only: uncomment both for the mock login. Never set these on a shared environment.
# AUTH_PROVIDER=mock
# /auth/mock-login and /dev/* exist only when AUTH_PROVIDER=mock AND this is true.
# ENABLE_DEV_ENDPOINTS=true
# Must be at least 32 characters. Replace for anything but local dev.
# Generate with: openssl rand -base64 48 . Empty on purpose: the API refuses to start without it.
JWT_SECRET=
# Cookie: httpOnly, SameSite=Strict, Secure except on localhost (fixed, not configurable).

# --- Database (D-02): the app connects as ql_app, migrations run as ql_owner ---
DATABASE_URL=postgres://ql_app:ql_app_dev@localhost:5442/qualityloop
# Migration tooling only; the API must never load this.
MIGRATION_DATABASE_URL=postgres://ql_owner:ql_owner_dev@localhost:5442/qualityloop

# --- Data layer (D-05) ---
DATA_PROVIDER=postgres-mock

# --- Definitions (D-10): placeholders, all configurable ---
NEAR_EOL_MONTHS=6
TREND_DECLINING=-0.5
TREND_IMPROVING=0.5
TREND_WINDOW_DAYS=90
WARRANTY_EXPIRING_DAYS=90

# --- Notifications (D-07): unknown values fail at startup ---
NOTIFY_EMAIL=mock
NOTIFY_SMS=mock
NOTIFY_WEBHOOK=mock

# --- Rate limiting (D-14) ---
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_MINUTE=10

# --- Branding ---
PRODUCT_NAME=82V QualityLoop

# --- Web build (D-08): the dev login switcher is included only when true ---
# VITE_MOCK_AUTH=true
