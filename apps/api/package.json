{
  "name": "@ql/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --reporter=dot --passWithNoTests",
    "test:integration": "vitest run -c vitest.integration.config.ts --reporter=dot",
    "db:reset": "tsx src/data/cli/reset.ts",
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx --env-file=../../.env src/server.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@ql/contracts": "workspace:*",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.17.0",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "vitest": "^3.0.0"
  }
}
